# Physical AI — local runtime (copy to .env; never commit secrets)

# Bind address (localhost only by default)
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# CORS for local dashboard
# CORS_ORIGINS is JSON-list style if overridden via settings; defaults are localhost:3000

# Simulation
SEED_SIMULATED_DEVICE=true
SIMULATED_DEVICE_ID=rover-sim-001
MOCK_TELEMETRY_INTERVAL_SECONDS=1.0

# Optional override (default: runtime/data/physical_ai.db)
# DATABASE_PATH=/absolute/path/to/physical_ai.db

# Dashboard (also in apps/dashboard/.env.local)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# LLM keys are NOT stored here. Milestone 4 will use OS keyring.
# Do not put API keys in this file.
